+def draft_opd_loss(
+    unary_logits: torch.Tensor,
+    kl_mode: torch.Tensor,
+    target_ids: torch.Tensor,
+    pos_weight: torch.Tensor,
+    p_topk_tokens: torch.Tensor,
+    p_topk_logprobs: torch.Tensor,
+    lambda_rej: float | None = None,
+):
+    """Draft-OPD acceptance-aware objective (arXiv:2605.29343).
+
+    All inputs live on the anchor grid (gathered at anchored_block_indices).
+    Accepted positions (mode 1): forward-KL-equivalent CE toward the
+    target-verified token. Rejected suffix (mode 2): reverse KL(q||p) against
+    the stored target top-k distribution (renormalized; q mass outside the
+    stored top-k is the recorded smoke approximation), weighted by w_k.
+    Returns (scalar loss, metrics dict); (0, {}) when no opd positions.
+    """
+    import os
+
+    if lambda_rej is None:
+        lambda_rej = float(os.environ.get("DRAFT_OPD_LAMBDA_REJ", "1.0"))
+    device = unary_logits.device
+    m1 = (kl_mode == 1)[0]
+    m2 = (kl_mode == 2)[0]
+    if not (m1.any() or m2.any()):
+        return torch.zeros((), device=device, dtype=torch.float32), {}
+    logq = torch.log_softmax(unary_logits.float(), dim=-1)
+    L = unary_logits.shape[1]
+    idx = torch.arange(L, device=device)
+    t = target_ids[0].clamp(min=0).long()
+    ce = -logq[0, idx, t]
+    # raw position counts; the denominator is clamped once at the end so a
+    # missing mode (full-accept or all-rejected anchors) adds zero weight
+    n_acc = m1.sum().float()
+    acc_loss = (ce * m1).sum()
+    rej_loss = torch.zeros((), device=device)
+    n_rej = m2.sum().float()
+    if m2.any():
+        q = logq.exp()
+        valid = p_topk_tokens[0] >= 0
+        tok = p_topk_tokens[0].clamp(min=0).long()
+        p = torch.softmax(p_topk_logprobs[0].float(), dim=-1) * valid
+        p = p / p.sum(-1, keepdim=True).clamp(min=1e-9)
+        logp = torch.where(valid, p.clamp(min=1e-9).log(), torch.zeros_like(p))
+        qk = torch.gather(q[0], 1, tok)
+        logqk = torch.gather(logq[0], 1, tok)
+        kl = (qk * (logqk - logp) * valid).sum(-1)
+        n_rej = (pos_weight[0] * m2).sum()
+        rej_loss = (kl * pos_weight[0] * m2).sum() * lambda_rej
+    total = (acc_loss + rej_loss) / (n_acc + lambda_rej * n_rej).clamp(min=1e-9)
+    metrics = {}
+    if bool(m1.any()):
+        metrics["opd/acc_ce"] = (acc_loss / n_acc.clamp(min=1)).detach()
+    if bool(m2.any()):
+        metrics["opd/rej_rkl"] = (rej_loss / (lambda_rej * n_rej.clamp(min=1e-9))).detach()
+    metrics["opd/loss"] = total.detach()
+    return total, metrics
